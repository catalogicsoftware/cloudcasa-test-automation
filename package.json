{
  "name": "cloudcasa-auto-test",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:allure": "allure run --open -- playwright test",
    "allure:watch": "allure watch allure-results --port 5252 --open",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "1.61.1",
    "@testmo/testmo-cli": "^1.5.0",
    "@types/node": "^26.0.1",
    "allure": "^3.14.3",
    "allure-playwright": "^3.10.2",
    "diff": "^9.0.0",
    "dotenv": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.4",
    "typescript": "^5.4.0"
  }
}
