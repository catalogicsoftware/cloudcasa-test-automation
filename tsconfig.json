{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@page-object-model/*": ["page-object-model/*"],
      "@fixtures/*": ["fixtures/*"],
      "@data/*": ["data/*"],
      "@utils/*": ["utils/*"],
      "@page-factory/*": ["page-factory/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
