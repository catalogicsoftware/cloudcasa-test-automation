BASE_URL=https://auth.cloudcasa.io/
CC_EMAIL=your@email.com
CC_PASSWORD=yourpassword
SLOW_MO=0

# testmail.app inbox access. Test email addresses are NOT configured here --
# they are derived from tag constants in data/testmail-tags.ts as
# `<namespace>.<tag>@inbox.testmail.app`. See "Testmail tag convention" in CLAUDE.md.
TESTMAIL_NAMESPACE=namespace
TESTMAIL_API_KEY=your-testmail-api-key
TESTMAIL_API_URL=https://api.testmail.app/api/json

# CloudCasa REST API access, used by tests for arrange/teardown (e.g. creating
# and cancelling organization invitations). There is no login endpoint —
# generate a static API token in the CloudCasa UI. The URL is the full API base
# including /api/v1; override it for staging/self-hosted installations.
CLOUDCASA_API_URL=https://ui.staging.cloudcasa.io/api/v1
CLOUDCASA_API_TOKEN=your-api-token

# Password of the static registered staging user (email is derived from the
# invite-registered tag in data/testmail-tags.ts). Registered manually once --
# see the invite-registered-user test. The test never changes this password.
REGISTERED_USER_PASSWORD=password-of-static-registered-user