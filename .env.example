BASE_URL=https://auth.cloudcasa.io/
CC_EMAIL=your@email.com
CC_PASSWORD=yourpassword
SLOW_MO=0

# Dedicated CloudCasa test account used by the password-reset flow test.
# It must be a testmail.app inbox address, since the test reads the reset
# email via the testmail.app API. Keep this SEPARATE from CC_EMAIL/CC_PASSWORD
# above -- the test changes this account's password on every run (the forgot-
# password flow never needs to know the current password, so there's nothing
# to keep in sync), which would break other tests if they shared the same account.
RESET_PWD_EMAIL=namespace.tag@inbox.testmail.app
TESTMAIL_NAMESPACE=namespace
TESTMAIL_API_KEY=your-testmail-api-key