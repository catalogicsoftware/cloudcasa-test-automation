BASE_URL=https://auth.cloudcasa.io/
CC_EMAIL=your@email.com
CC_PASSWORD=yourpassword
SLOW_MO=0
# Only for pointing the sign-up tests at another environment; defaults to https://signup.cloudcasa.io/
SIGNUP_URL=

# Mailinator inbox access. Test email addresses are NOT configured here -- they are
# derived from the inbox constants in data/mailinator-inboxes.ts as `<inbox>@<domain>`.
# See "Mailinator inbox convention" in CLAUDE.md. The domain must be the Verified Pro
# private domain: clearing an inbox is rejected on public ones.
MAILINATOR_DOMAIN=your-private-domain.com
MAILINATOR_API_TOKEN=your-mailinator-api-token
# Optional; utils/mailinator.ts already defaults to this value.
MAILINATOR_API_URL=https://mailinator.com/api/v2

# CloudCasa REST API access, used by tests for arrange/teardown (e.g. creating
# and cancelling organization invitations). There is no login endpoint —
# generate a static API token in the CloudCasa UI. The URL is the full API base
# including /api/v1; override it for staging/self-hosted installations.
CLOUDCASA_API_URL=https://ui.staging.cloudcasa.io/api/v1
CLOUDCASA_API_TOKEN=your-api-token

# Credentials for the S3 targets the happy-path storage test adds; bucket, endpoint
# and region live in the catalog in data/storage.ts instead. A target whose pair is
# unset is skipped, so a CI run without the credentials stays green.
AWS_ACCESS_KEY=your-access-key-id
AWS_SECRET_KEY=your-secret-access-key
DATA_CORE_ACCESS_KEY=your-access-key-id
DATA_CORE_SECRET_KEY=your-secret-access-key

# Service principal the Azure target authenticates with -- the form offers no other
# method. Resource group, storage account and region live in the catalog in
# data/storage.ts; the subscription id stays here because it identifies the account.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id
